{
  "name": "yskill",
  "version": "0.3.0",
  "description": "Shortcut CLI for installing yikZero/skills with the skills CLI.",
  "type": "module",
  "bin": {
    "yskill": "bin/yskill.js"
  },
  "files": [
    "bin/yskill.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yikZero/skills.git"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.4.3"
  },
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "test:cli": "node scripts/test-yskill-cli.mjs",
    "skills:list": "npx skills@latest add . --list",
    "cli:list": "node bin/yskill.js --list"
  }
}
